{
  "name": "eventhub-backend",
  "version": "1.0.0",
  "description": "EventHub REST API — Node.js 20 + Express + PostgreSQL",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev":   "node --watch src/server.js",
    "start": "node src/server.js",
    "seed":  "node scripts/seed.js",
    "test":  "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".js"],
    "testMatch": ["**/tests/**/*.test.js"],
    "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" }
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
